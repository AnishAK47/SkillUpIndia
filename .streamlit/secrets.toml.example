# Template only. Paste the filled-in version into Streamlit Community Cloud
# (App settings -> Secrets), or save it locally as .streamlit/secrets.toml,
# which is git-ignored. Never commit real values.

# Sign-in through Auth0 (Google + email/password). See README "Accounts and roles".
[auth]
redirect_uri = "https://skillupindia.streamlit.app/oauth2callback"  # local: http://localhost:8501/oauth2callback
cookie_secret = "a-long-random-string"  # python -c "import secrets; print(secrets.token_urlsafe(32))"
client_id = "your-auth0-client-id"
client_secret = "your-auth0-client-secret"
server_metadata_url = "https://YOUR-TENANT.us.auth0.com/.well-known/openid-configuration"

# Verified emails that get admin access.
[access]
admins = ["you@example.com"]

# Supabase database (run supabase/schema.sql first). The service-role key
# bypasses row-level security, so it must only ever live in secrets.
[supabase]
url = "https://YOUR-PROJECT.supabase.co"
service_role_key = "your-service-role-key"

# Optional: also open each feedback report as a GitHub issue.
[github]
token = "your-fine-grained-token"
repo = "AnishAK47/SkillUpIndia"
